#!/bin/bash
# First-boot script for the API host (Amazon Linux 2023).
# Installs Docker and creates /usr/local/bin/deploy-app.sh, which is also
# what the CI/CD pipeline runs (through SSM Run Command) on every release.
set -euo pipefail

dnf update -y
dnf install -y docker
systemctl enable --now docker

cat > /usr/local/bin/deploy-app.sh <<'SCRIPT'
#!/bin/bash
# Pulls the API image from ECR and (re)starts the container.
# Usage: deploy-app.sh [image-tag]
set -euo pipefail

TAG="$${1:-${default_tag}}"
REGION="${region}"
REGISTRY="${registry}"
IMAGE="${image}:$TAG"

get_param() {
  aws ssm get-parameter --region "$REGION" --name "${parameter_path}/$1" \
    --with-decryption --query Parameter.Value --output text
}

aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$REGISTRY"
docker pull "$IMAGE"

# Secrets are written to a root-only file and passed to the container as env vars
umask 077
cat > /etc/api.env <<ENV
DB_HOST=$(get_param host)
DB_NAME=$(get_param name)
DB_USER=$(get_param user)
DB_PASSWORD=$(get_param password)
DB_SSLMODE=require
ENV

docker rm -f api >/dev/null 2>&1 || true
docker run -d --name api --restart unless-stopped \
  -p 80:8000 \
  --env-file /etc/api.env \
  --log-driver awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="${log_group}" \
  --log-opt awslogs-stream="api-$(hostname)" \
  "$IMAGE"

echo "$TAG" > /etc/api-image-tag
docker image prune -f >/dev/null
echo "Deployed $IMAGE"
SCRIPT
chmod 750 /usr/local/bin/deploy-app.sh

# On the very first apply the image may not exist yet: the pipeline deploys it later
/usr/local/bin/deploy-app.sh || echo "No image in ECR yet - it will be deployed by the CI/CD pipeline"
