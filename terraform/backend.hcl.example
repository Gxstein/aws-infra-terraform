# Copy to backend.hcl and use: terraform init -backend-config=backend.hcl
# The bucket is created by the stack in ../bootstrap (see its output state_bucket_name)
bucket       = "aws-infra-tfstate-123456789012"
key          = "aws-infra-terraform/dev/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
